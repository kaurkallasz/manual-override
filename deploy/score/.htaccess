Options -Indexes
DirectoryIndex index.html
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://mecharena.eu%{REQUEST_URI} [R=301,L]
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
<FilesMatch "^(config|core|pairing-requests)\.php$">
Require all denied
</FilesMatch>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "no-referrer"
Header always set X-Frame-Options "DENY"
Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
</IfModule>
